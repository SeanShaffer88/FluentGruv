{
  "$schema": "FluentGruv tokens \u2014 machine-readable companion to TOKENS.md",
  "colors": {
    "accent": {
      "primary": "#FB4934",
      "secondary": "#CC241D",
      "subtle": "#3B1D1B"
    },
    "bg": {
      "canvas": "#1D2021",
      "elevated": "#32302F",
      "sunken": "#171819",
      "surface": "#282828"
    },
    "border": {
      "strong": "#504945",
      "subtle": "#3C3836"
    },
    "fg": {
      "inverse": "#1D2021",
      "muted": "#A89984",
      "primary": "#EBDBB2",
      "secondary": "#D5C4A1"
    },
    "status": {
      "danger": "#FB4934",
      "success": "#B8BB26",
      "warning": "#FABD2F"
    }
  },
  "dpi": {
    "mode": "Per-Monitor DPI V2",
    "scaleAllDimensions": true,
    "syncOnThemeChange": true
  },
  "focusRing": {
    "colorToken": "accent.primary",
    "dark": "#FB4934",
    "light": "#CC241D",
    "style": "solid",
    "widthPx": 2
  },
  "name": "FluentGruv",
  "palette": "Gruvbox Dark + Bespoke Red (default) / Gruvbox Light",
  "radius": {
    "compactPx": 2,
    "fullBleedPx": 0,
    "standardPx": 4
  },
  "spacing": {
    "baseUnitPx": 4,
    "scalePx": [
      4,
      8
    ]
  },
  "themes": {
    "dark": {
      "accent": {
        "primary": "#FB4934",
        "secondary": "#CC241D",
        "subtle": "#3B1D1B"
      },
      "bg": {
        "canvas": "#1D2021",
        "elevated": "#32302F",
        "sunken": "#171819",
        "surface": "#282828"
      },
      "border": {
        "strong": "#504945",
        "subtle": "#3C3836"
      },
      "fg": {
        "inverse": "#1D2021",
        "muted": "#A89984",
        "primary": "#EBDBB2",
        "secondary": "#D5C4A1"
      },
      "status": {
        "danger": "#FB4934",
        "success": "#B8BB26",
        "warning": "#FABD2F"
      }
    },
    "light": {
      "accent": {
        "primary": "#CC241D",
        "secondary": "#9D0006",
        "subtle": "#F9E0DC"
      },
      "bg": {
        "canvas": "#F9F5D7",
        "elevated": "#EBDBB2",
        "sunken": "#F2E5BC",
        "surface": "#FBF1C7"
      },
      "border": {
        "strong": "#BDAE93",
        "subtle": "#D5C4A1"
      },
      "fg": {
        "inverse": "#FBF1C7",
        "muted": "#665C54",
        "primary": "#3C3836",
        "secondary": "#504945"
      },
      "status": {
        "danger": "#CC241D",
        "success": "#98971A",
        "warning": "#D79921"
      }
    }
  },
  "typography": {
    "monoFont": [
      "Consolas",
      "Cascadia Mono",
      "JetBrains Mono"
    ],
    "tabularFigures": true,
    "uiFont": [
      "Segoe UI",
      "system-ui"
    ]
  },
  "version": "1.1.0"
}
